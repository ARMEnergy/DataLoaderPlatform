<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Name the assembly to match the loader's InternalsVisibleTo so the descriptors,
         the mapper, the session and the sink are testable. -->
    <AssemblyName>DataLoader.Marex.Tests</AssemblyName>
    <!-- Same suppressions as the loader: the vendored Neon assemblies are net461, and
         the SDK's pinned dependencies carry published advisories. See lib/neon/README.md. -->
    <NoWarn>$(NoWarn);NU1701;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Skip.IfNot, for the opt-in live gateway smoke test. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataLoader.Marex\DataLoader.Marex.csproj" />
  </ItemGroup>

  <!-- A <Reference> with a HintPath does not flow transitively through a
       ProjectReference the way a PackageReference does, so the tests name the three
       vendored assemblies themselves. MarexSdkContractTests reflects over them
       directly, and the fake client implements INeonApiClient. -->
  <ItemGroup>
    <Reference Include="Neon.API">
      <HintPath>..\..\lib\neon\Neon.API.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SignalRClient">
      <HintPath>..\..\lib\neon\SignalRClient.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Common.Core">
      <HintPath>..\..\lib\neon\Common.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- log4net is needed directly: MarexSdkLogBridgeTests constructs LoggingEvent. -->
  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.15" />
  </ItemGroup>
</Project>
