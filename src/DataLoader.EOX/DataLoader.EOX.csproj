<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataLoader.EOX</RootNamespace>
    <AssemblyName>DataLoader.EOX</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DataLoader.Core\DataLoader.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FluentFTP (MIT) — plain/explicit-TLS FTP client for ftp.eoxlive.com:21,
         the same package and version the OPIS and Argus loaders use. Platts'
         SSH.NET driver speaks SFTP and cannot serve this feed;
         System.Net.FtpWebRequest is obsolete (SYSLIB0014) on net8.0. -->
    <PackageReference Include="FluentFTP" Version="53.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DataLoader.EOX.Tests" />
  </ItemGroup>
</Project>
