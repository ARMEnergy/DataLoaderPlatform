<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataLoader.CME</RootNamespace>
    <AssemblyName>DataLoader.CME</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DataLoader.Core\DataLoader.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SSH.NET (Renci.SshNet, MIT) — SSH SFTP client for
         sftp.cmeprod.datahex.rozettatech.com. The drop speaks SSH SFTP, so the
         FluentFTP driver the OPIS/Argus/EOX loaders use cannot serve it.

         Kept in lockstep with DataLoader.Platts: the host references every
         loader project, so NuGet unifies this package across the whole app and
         a one-sided bump would silently change Platts' SSH stack too.

         2026.0.0 clears advisory GHSA-q939-rpr3-3284 / CVE-2026-48798 (path
         traversal in ScpClient's recursive download). Neither loader uses
         ScpClient — both drivers only ever call SftpClient.ListDirectory and
         .DownloadFile — so the fix is about the NU1903 build warning, not an
         exposure either loader had. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DataLoader.CME.Tests" />
  </ItemGroup>
</Project>
