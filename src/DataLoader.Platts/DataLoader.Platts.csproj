<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataLoader.Platts</RootNamespace>
    <AssemblyName>DataLoader.Platts</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DataLoader.Core\DataLoader.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SSH.NET (Renci.SshNet, MIT) — SSH SFTP client for sftp.platts.com.

         Kept in lockstep with DataLoader.CME: the host references both loader
         projects, so NuGet unifies this package across the whole app and a
         one-sided bump would silently change the other loader's SSH stack. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
