{
  "Platform": {
    "EnabledLoaders": [ "EnergyAspects", "Vulcan", "Platts", "StormVista" ],
    "MaxConcurrentLoaders": 3,
    "LoadLogConnectionString": "Server=ARMH-OPSDB01;Database=DataLoaderPlatform;Integrated Security=SSPI;TrustServerCertificate=True;",
    "DefaultDaysBackStart": 90,
    "DefaultDaysBackEnd": 0
  },

  "Loaders": {
    "EnergyAspects": {
      "ConnectionString": "Server=ARMH-OPSDB01;Database=EnergyAspects;Integrated Security=SSPI;TrustServerCertificate=True;",
      "MaxConcurrentWorkUnits": 4,
      "RetryCount": 3,
      "RetryDelayMs": 500,
      "WorkUnitTimeoutSeconds": 300,
      "ApiKey": "SEE_DB",
      "BaseUrl": "https://api.energyaspects.com",
      "MappingsEndpoint": "/data/dataset_mappings",
      "TimeseriesEndpoint": "/data/timeseries/",
      "HttpTimeoutSeconds": 30,
      "TimeseriesWindowDays": 30,
      "DaysBackStart": 90,
      "DaysBackEnd": 0
    },

    "Vulcan": {
      "ConnectionString": "Server=ARMH-OPSDB01;Database=Vulcan;Integrated Security=SSPI;TrustServerCertificate=True;",
      "MaxConcurrentWorkUnits": 5,
      "RetryCount": 3,
      "RetryDelayMs": 1000,
      "WorkUnitTimeoutSeconds": 7200,
      "ApiKey": "SEE_DB",
      "BaseUrl": "https://hyperion.api.synmax.com",
      "QueryEndpoint": "/v4/beta/query_datalinks",
      "HttpTimeoutSeconds": 300,
      "PageSize": 10000,
      "MaxPages": 100000,
      "EnabledTables": [ "under_construction", "datacenters", "lng_projects", "project_rankings", "metadata_history" ]
    },

    "Platts": {
      "ConnectionString": "Server=ARMH-OPSDB01;Database=Platts;Integrated Security=SSPI;TrustServerCertificate=True;",
      "MaxConcurrentWorkUnits": 4,
      "RetryCount": 3,
      "RetryDelayMs": 1000,
      "WorkUnitTimeoutSeconds": 600,
      "SftpHost": "sftp.platts.com",
      "SftpPort": 22,
      "SftpUsername": "SEE_DB",
      "SftpPassword": "SEE_DB",
      "RootDirectory": "/",
      "DateFolderPattern": "^\\d{8}$",
      "MarketDataFilePattern": "*.ftp",
      "SymbolsDirectory": "symbols/csv-version",
      "SymbolFilePattern": "*.csv",
      "EnabledFeeds": [ "SymbolData", "Symbol" ]
    },

    "StormVista": {
      "ConnectionString": "Server=ARMH-OPSDB01;Database=StormVista;Integrated Security=SSPI;TrustServerCertificate=True;",
      "MaxConcurrentWorkUnits": 8,
      "RetryCount": 3,
      "RetryDelayMs": 1000,
      "WorkUnitTimeoutSeconds": 120,
      "BaseUrl": "https://api.stormvistawxmodels.com/v1",
      "ApiKey": "SEE_DB",
      "HttpTimeoutSeconds": 60,
      "EnabledFeeds": [ "Daily", "Regional" ],
      "Mode": "Incremental",
      "DaysBack": 21,
      "SettledAfterDays": 21,
      "ChunkDays": 30,
      "RequestsPerSecond": 25,
      "HotZoneKeyStrategy": "RunId",
      // true = skip models flagged IsExperimental in the reference; false = load everything (default)
      "ExcludeExperimental": false
    },

    // CWG is DISABLED by default (not in Platform:EnabledLoaders) — build-only pass.
    // Enable by adding "CWG" to Platform:EnabledLoaders (or pass it as a CLI arg).
    "CWG": {
      "ConnectionString": "Server=ARMH-OPSDB01;Database=CWG;Integrated Security=SSPI;TrustServerCertificate=True;",
      "MaxConcurrentWorkUnits": 8,
      "RetryCount": 3,
      "RetryDelayMs": 1000,
      "WorkUnitTimeoutSeconds": 120,
      "BaseUrl": "https://api.commoditywx.com/v1",
      "ApiKey": "SEE_DB",
      "HttpTimeoutSeconds": 60,
      "EnabledEndpoints": [
        "CityForecast", "CityGasForecast", "CityObservation", "DailyNormal", "SolarForecast",
        "SolarForecastChange", "SolarHourly", "NationalDegreeDays", "WindForecast", "WindForecastSubRegion",
        "WindHourly", "WindTotalCapacityClimatology", "WindTotalCapacityMW", "WindTotalCapacityPct", "Station"
      ],
      "DaysBack": 21,
      "SettledAfterDays": 7,
      "HotZoneKeyStrategy": "RunDate",
      "Geographies": [ "northamerica", "asia", "europe" ],
      "RequestsPerSecond": 25
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
