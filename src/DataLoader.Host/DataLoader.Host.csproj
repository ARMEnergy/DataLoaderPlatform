<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataLoader.Host</RootNamespace>
    <AssemblyName>DataLoader.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataLoader.Core\DataLoader.Core.csproj" />
    <!-- Reference loader plugin projects here to deploy them with the host.
         Adding a new loader = adding a ProjectReference here. -->
    <ProjectReference Include="..\DataLoader.EnergyAspects\DataLoader.EnergyAspects.csproj" />
    <ProjectReference Include="..\DataLoader.Vulcan\DataLoader.Vulcan.csproj" />
    <ProjectReference Include="..\DataLoader.Platts\DataLoader.Platts.csproj" />
    <ProjectReference Include="..\DataLoader.StormVista\DataLoader.StormVista.csproj" />
    <ProjectReference Include="..\DataLoader.CWG\DataLoader.CWG.csproj" />
    <ProjectReference Include="..\DataLoader.AGSI\DataLoader.AGSI.csproj" />
    <ProjectReference Include="..\DataLoader.IHSPointLogic\DataLoader.IHSPointLogic.csproj" />
    <ProjectReference Include="..\DataLoader.IIR\DataLoader.IIR.csproj" />
    <ProjectReference Include="..\DataLoader.OPIS\DataLoader.OPIS.csproj" />
    <ProjectReference Include="..\DataLoader.NGI\DataLoader.NGI.csproj" />
    <ProjectReference Include="..\DataLoader.ModernCommodities\DataLoader.ModernCommodities.csproj" />
    <ProjectReference Include="..\DataLoader.EvolutionMarkets\DataLoader.EvolutionMarkets.csproj" />
    <ProjectReference Include="..\DataLoader.Argus\DataLoader.Argus.csproj" />
    <ProjectReference Include="..\DataLoader.ICE\DataLoader.ICE.csproj" />
    <ProjectReference Include="..\DataLoader.Criterion\DataLoader.Criterion.csproj" />
    <ProjectReference Include="..\DataLoader.EOX\DataLoader.EOX.csproj" />
    <ProjectReference Include="..\DataLoader.CME\DataLoader.CME.csproj" />
    <ProjectReference Include="..\DataLoader.Genscape\DataLoader.Genscape.csproj" />
    <ProjectReference Include="..\DataLoader.NGX\DataLoader.NGX.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
