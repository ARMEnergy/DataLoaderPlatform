
#Ignore thumbnails created by Windows
Thumbs.db
#Ignore files built by Visual Studio
*.obj
*.exe
*.pdb
*.user
*.aps
*.pch
*.vspscc
*_i.c
*_p.c
*.ncb
*.suo
*.tlb
*.tlh
*.bak
*.cache
*.ilk
*.log
[Bb]in
[Dd]ebug*/
*.lib
*.sbr
obj/
[Rr]elease*/
_ReSharper*/
[Tt]est[Rr]esult*
.vs/
.idea/
#Nuget packages folder
packages/

#Local developer config overlay - never commit (holds machine-specific paths and may hold secrets)
appsettings.Local.json

# Build output. The [Bb]in and obj/ rules above already covered src/*/bin and
# src/*/obj, but 1,031 such files had been committed before those rules existed
# and gitignore has no effect on files already in the index -- so they churned on
# every build. Untracked 2026-11-03; the files stay on disk and are regenerated by
# `dotnet build`.
/publish/

# `dotnet publish` staging used by scripts\Release.ps1 (its default -PublishDir).
/publish-staging/

# NOT ignored, and must stay tracked: lib/neon/*.dll are the vendored Marex Neon
# SDK assemblies, which exist on no NuGet feed and cannot be restored. This
# negation is defensive -- no rule above matches them today, but a future blanket
# *.dll rule would silently break the Marex build without it.
!lib/neon/*.dll
